# Cache the runner's fixed queries in one jq process. Values remain data, never shell code.
[
  [".build.apkPath", ([.build.apkPath] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".build.cli // \"unity\"", ([.build.cli // "unity"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".build.devMethod", ([.build.devMethod] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".build.profile // empty", ([.build.profile // empty] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".build.releaseApkPath // .build.apkPath", ([.build.releaseApkPath // .build.apkPath] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".build.releaseMethod", ([.build.releaseMethod] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".knownFlakes // \"\"", ([.knownFlakes // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".labMethod // empty", ([.labMethod // empty] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.atlasPath // \"\"", ([.noise.atlasPath // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.codeRegex // \"^Assets/(Scripts|Editor)/|\\\\.(cs|asmdef)$\"", ([.noise.codeRegex // "^Assets/(Scripts|Editor)/|\\.(cs|asmdef)$"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.fixedTimestepCount // \"\"", ([.noise.fixedTimestepCount // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.generatorsRegex // \"a^\"", ([.noise.generatorsRegex // "a^"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.propsDir // \"Assets/Art/Props\"", ([.noise.propsDir // "Assets/Art/Props"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.protectedRegex // \"^Assets/Scenes/\"", ([.noise.protectedRegex // "^Assets/Scenes/"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.repackRegex // \"a^\"", ([.noise.repackRegex // "a^"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.sourceRegex // \"\\\\.(glb|fbx|jpg|jpeg|png|tga|psd)(\\\\.meta)?$\"", ([.noise.sourceRegex // "\\.(glb|fbx|jpg|jpeg|png|tga|psd)(\\.meta)?$"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.specularMaterialPath // \"\"", ([.noise.specularMaterialPath // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".noise.timeManagerPath // \"ProjectSettings/TimeManager.asset\"", ([.noise.timeManagerPath // "ProjectSettings/TimeManager.asset"] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.areaStep // empty", ([.scene.areaStep // empty] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.areaSteps // [.scene.steps[0], .scene.areaStep] | .[]", ([.scene.areaSteps // [.scene.steps[0], .scene.areaStep] | .[]] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.areasDir", ([.scene.areasDir] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.areasDir // \"\"", ([.scene.areasDir // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.areasFile // \"\"", ([.scene.areasFile // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.keepPaths[]?", ([.scene.keepPaths[]?] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.lightmapDir // \"\"", ([.scene.lightmapDir // ""] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.lightmapDir // empty", ([.scene.lightmapDir // empty] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".scene.steps[]", ([.scene.steps[]?] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".setup.craneArchive // empty", ([.setup.craneArchive // empty] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".tests.builderFixtures // {} | to_entries[] | .key as $path | .value[] | [$path, .] | @tsv", ([.tests.builderFixtures // {} | to_entries[] | .key as $path | .value[] | [$path, .] | @tsv] | map(if type == "string" then . else tostring end) | join("\n"))],
  [".tests.root // \"Assets/Tests\"", .tests.root // "Assets/Tests"],
  [".tests.editModeRoot // ((.tests.root // \"Assets/Tests\") + \"/EditMode\")", .tests.editModeRoot // ((.tests.root // "Assets/Tests") + "/EditMode")],
  [".tests.scriptsRoot // \"Assets/Scripts\"", .tests.scriptsRoot // "Assets/Scripts"],
  [".tests.editorRoot // \"Assets/Editor\"", .tests.editorRoot // "Assets/Editor"],
  [".unityVersion", ([.unityVersion] | map(if type == "string" then . else tostring end) | join("\n"))],
  ["has(\"scene\")", ([has("scene")] | map(if type == "string" then . else tostring end) | join("\n"))]
][] | .[0], "\u0000", .[1], "\u0000"
